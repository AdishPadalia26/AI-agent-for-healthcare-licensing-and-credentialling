# Copy to backend/config/.env or backend/.env. All values below are placeholders.

# --- Providers ---
# gemini | local. "local" uses regex extraction and no generative mapping (offline demo).
LLM_PROVIDER=gemini
# textract | local. "local" reads the PDF text layer only.
OCR_PROVIDER=textract
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- AWS ---
AWS_ACCESS_KEY_ID=replace_with_aws_access_key
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
# AWS_SESSION_TOKEN=only_for_temporary_credentials

# --- Storage --- Textract requires STORAGE_BACKEND=s3.
STORAGE_BACKEND=local
AWS_S3_BUCKET_NAME=replace_with_bucket_name

# --- API ---
# Must match BACKEND_JWT_SECRET (or NEXTAUTH_SECRET) in frontend/.env.local.
BACKEND_JWT_SECRET=replace_with_random_secret
DATA_ENCRYPTION_KEY=replace_with_a_different_random_secret
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAILS=admin@example.com
FLASK_DEBUG=1
# DATABASE_URL=postgresql+psycopg://user:password@host/db

# --- Retrieval --- Leave unset for an in-process store.
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_API_KEY=

# --- Review thresholds ---
AUTO_FILL_THRESHOLD=0.80
REVIEW_THRESHOLD=0.50
